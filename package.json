{
  "name": "string-sort",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "assets:android": "npx @capacitor/assets generate --android --iconBackgroundColor '#f7dfb9' --iconBackgroundColorDark '#242932' --splashBackgroundColor '#f7dfb9' --splashBackgroundColorDark '#242932'",
    "assets:store": "node scripts/build-store-assets.mjs",
    "screenshots:store": "node scripts/capture-store-screenshots.mjs",
    "verify": "npm test && npm run build && npm run verify:release",
    "verify:release": "node scripts/verify-release-readiness.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "happy-dom": "^18.0.1",
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.34.3",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.8"
}
