{
  "name": "string-sort",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "assets": "node scripts/android.mjs assets",
    "build:android": "node scripts/android.mjs open",
    "build:android:prod": "node scripts/android.mjs open --prod",
    "android:apk": "node scripts/android.mjs apk",
    "android:apk:prod": "node scripts/android.mjs apk --prod",
    "android:install": "node scripts/android.mjs install",
    "android:install:prod": "node scripts/android.mjs install --prod",
    "android:aab": "node scripts/android.mjs aab",
    "test": "vitest run",
    "assets:store": "node scripts/build-store-assets.mjs",
    "screenshots:store": "node scripts/capture-store-screenshots.mjs",
    "screenshots:verify": "node scripts/verify-store-screenshots.mjs",
    "verify": "npm test && npm run build:prod && npm run verify:release",
    "verify:release": "node scripts/verify-release-readiness.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "happy-dom": "^18.0.1",
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.34.3",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.8"
}
